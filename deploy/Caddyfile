# Serves the built web on $PORT (Railway sets it). Hashed assets are cached for a year; every other path is the app
# itself (index.html), which is never cached so a new deploy shows at once.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	@assets path /assets/*
	@app not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @app Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
